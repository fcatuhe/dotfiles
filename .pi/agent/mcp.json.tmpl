{
  "mcpServers": {
    "outline-patoumatic": {
      "url": "https://patoumatic.getoutline.com/mcp",
      "description": "Search, read and edit the Patoumatic Outline wiki"
    },
    "outline-ridecell": {
      "url": "https://outline.ridecell.tech/mcp",
      "description": "Search, read and edit the Ridecell Outline wiki"
    },
    "slack-ridecell": {
      "url": "https://mcp.slack.com/mcp",
      "description": "Search and read Ridecell Slack messages, channels and canvases",
      "oauth": {
        "clientId": "{{ secret(name="SLACK_RIDECELL_MCP_CLIENT_ID") }}",
        "clientSecret": "{{ secret(name="SLACK_RIDECELL_MCP_CLIENT_SECRET") }}",
        "callbackUrl": "http://localhost:8765/callback"
      }
    },
    "badger": {
      "url": "https://badger.ridecell.tech/mcp",
      "oauth": {
        "clientRegistration": "cimd"
      },
      "description": "Read badger captures, transcripts, summaries, insights and events"
    }
  }
}
