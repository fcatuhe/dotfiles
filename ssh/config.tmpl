Host patoumatic dropbear-patoumatic
  HostName {{ vars.SSH_PATOUMATIC_IP }}
  User {{ vars.SSH_PATOUMATIC_USER }}

Host dropbear-patoumatic
  Port 2222

Host crooz
  HostName {{ vars.SSH_CROOZ_IP }}
  User {{ vars.SSH_CROOZ_USER }}

Host azade
  HostName {{ vars.SSH_AZADE_IP }}
  User {{ vars.SSH_AZADE_USER }}

Host flyzilla
  HostName {{ vars.SSH_FLYZILLA_IP }}
  User {{ vars.SSH_FLYZILLA_USER }}

Host vast-ai
  HostName {{ vars.SSH_VAST_AI_IP }}
  Port {{ vars.SSH_VAST_AI_PORT }}
  User {{ vars.SSH_VAST_AI_USER }}

# Route GitHub SSH over 443 when port 22 is blocked
# Host github.com
#   HostName ssh.github.com
#   Port 443
#   User git

# macOS-specific: Bitwarden desktop is sandboxed, socket lives under Containers.
# Match blocks come first so their IdentityAgent wins over the Host * default.
Match host * exec "uname | grep -q Darwin"
  IdentityAgent ~/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock
  Include ~/.colima/ssh_config

Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  IdentityAgent ~/.bitwarden-ssh-agent.sock
