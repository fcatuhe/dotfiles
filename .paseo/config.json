{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "hostnames": [
      "fc-agents.airplane-catfish.ts.net"
    ],
    "mcp": {
      "injectIntoAgents": true
    },
    "browserTools": {
      "enabled": true
    },
    "autoArchiveAfterMerge": true,
    "terminalProfiles": [
      {
        "id": "pi",
        "name": "Pi",
        "command": "pi",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "pi"
      },
      {
        "id": "claude",
        "name": "Claude Code",
        "command": "claude",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "claude"
      },
      {
        "id": "codex",
        "name": "Codex",
        "command": "codex",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "codex"
      },
      {
        "id": "opencode",
        "name": "OpenCode",
        "command": "opencode",
        "args": [
          "--prompt={{{prompt}}}"
        ],
        "icon": "opencode"
      }
    ],
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": false
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "pluginsEnabled": true,
  "plugins": {
    "paseo-cafe": {
      "source": "directory",
      "path": "/home/francois/.paseo/plugins/paseo-cafe/d4442e46-a5ac-4d12-be63-ccf3161f178d/node_modules/paseo-cafe",
      "enabled": true
    },
    "host-monitor": {
      "source": "directory",
      "path": "/home/francois/.paseo/plugins/host-monitor/13ae7522-279a-4658-9a72-95fb30cc940f/checkout/plugins/host-monitor",
      "enabled": true
    }
  },
  "agents": {
    "providers": {
      "muse": {
        "enabled": false
      },
      "antigravity": {
        "enabled": false
      },
      "opencode": {
        "enabled": false
      },
      "copilot": {
        "enabled": false
      },
      "codex": {
        "enabled": false
      },
      "claude": {
        "enabled": false
      }
    },
    "metadataGeneration": {
      "providers": [
        {
          "provider": "pi",
          "model": "anthropic/claude-haiku-5-5"
        }
      ]
    }
  },
  "features": {
    "dictation": {
      "stt": {
        "provider": "local",
        "model": "parakeet-tdt-0.6b-v3-int8"
      }
    },
    "voiceMode": {
      "enabled": true,
      "stt": {
        "provider": "local",
        "model": "parakeet-tdt-0.6b-v3-int8"
      }
    }
  }
}
