partial alphanumeric_keys
xkb_symbols "ansi" {

    name[Group1] = "frenchy-clavier (AZERTY) ANSI";

    key <TLDE> { [ at              , twosuperior     , U00B3           , U00BD ] };
    key <AE01> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ agrave          , 1               , section         , Agrave ] };
    key <AE02> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ egrave          , 2               , NoSymbol        , Egrave ] };
    key <AE03> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ eacute          , 3               , ampersand       , Eacute ] };
    key <AE04> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ parenleft       , 4               , braceleft ] };
    key <AE05> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ parenright      , 5               , braceright ] };
    key <AE06> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ asciitilde      , 6               , dead_tilde ] };
    key <AE07> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ dead_diaeresis  , 7 ] };
    key <AE08> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ dead_circumflex , 8               , asciicircum ] };
    key <AE09> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ asterisk        , 9               , multiply ] };
    key <AE10> { type[Group1] = "FRENCHY_DIGITS_LOCK", [ plus            , 0               , division ] };
    key <AE11> { [ underscore      , percent ] };
    key <AE12> { [ equal           , degree ] };
    key <AD01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ a               , A               , ae              , AE ] };
    key <AD02> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ z               , Z ] };
    key <AD03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ e               , E               , EuroSign ] };
    key <AD04> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ r               , R               , bracketleft ] };
    key <AD05> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ t               , T               , bracketright ] };
    key <AD06> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ y               , Y ] };
    key <AD07> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ u               , U               , ugrave          , Ugrave ] };
    key <AD08> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ i               , I ] };
    key <AD09> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ o               , O               , oe              , OE ] };
    key <AD10> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ p               , P ] };
    key <AD11> { [ minus           , grave           , plusminus       , dead_grave ] };
    key <AD12> { [ slash           , bar             , U2019           , dead_acute ] };
    key <BKSL> { [ numbersign      , backslash ] };
    key <AC01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ q               , Q ] };
    key <AC02> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ s               , S               , dollar          , sterling ] };
    key <AC03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ d               , D ] };
    key <AC04> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ f               , F               , less            , U2264 ] };
    key <AC05> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ g               , G               , greater         , U2265 ] };
    key <AC06> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ h               , H ] };
    key <AC07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ j               , J ] };
    key <AC08> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ k               , K ] };
    key <AC09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ l               , L ] };
    key <AC10> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ m               , M               , mu ] };
    key <AC11> { [ apostrophe      , quotedbl ] };
    key <AB01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ w               , W ] };
    key <AB02> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ x               , X ] };
    key <AB03> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ c               , C               , ccedilla        , Ccedilla ] };
    key <AB04> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ v               , V               , guillemotleft ] };
    key <AB05> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ b               , B               , guillemotright ] };
    key <AB06> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ n               , N ] };
    key <AB07> { [ period          , period ] };
    key <AB08> { [ comma           , semicolon ] };
    key <AB09> { [ colon           , periodcentered ] };
    key <AB10> { [ question        , exclam ] };
    key <SPCE> { [ space           , space           , nobreakspace    , U202F ] };
    key <CAPS> { type[Group1] = "TWO_LEVEL", [ Multi_key       , ISO_Level5_Lock ] };

    include "frenchy(shiftlock)"
    include "level3(ralt_switch)"
    include "keypad(oss)"
};

default partial alphanumeric_keys
xkb_symbols "iso" {

    include "frenchy(ansi)"

    name[Group1] = "frenchy-clavier (AZERTY) ISO";

    replace key <BKSL> { type[Group1] = "ONE_LEVEL", [ Return ] };
    replace key <LSGT> { [ numbersign      , backslash ] };
};

partial modifier_keys
xkb_symbols "shiftlock" {

    key <LFSH> { type[Group1] = "ALPHABETIC", symbols[Group1] = [ Shift_L, VoidSymbol ], actions[Group1] = [ SetMods(modifiers=Shift,clearLocks), LockMods(modifiers=Lock) ] };
    key <RTSH> { type[Group1] = "ALPHABETIC", symbols[Group1] = [ Shift_R, VoidSymbol ], actions[Group1] = [ SetMods(modifiers=Shift,clearLocks), LockMods(modifiers=Lock) ] };
};

partial modifier_keys
xkb_symbols "digitlock" {

    key <CAPS> { type[Group1] = "TWO_LEVEL", [ Multi_key       , ISO_Level5_Lock ] };
};
