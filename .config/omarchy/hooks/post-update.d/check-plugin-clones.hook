#!/bin/bash

set -e
shopt -s nullglob

catalog=$(omarchy-plugin-catalog)

notify() {
  echo "$1: $2"
  omarchy-notification-send -u critical "Plugin clone out of date" "$1: $2"
}

for upstream in ~/.dotfiles/.config/omarchy/plugins/*/upstream; do
  clone=$(dirname "$upstream")
  source_id=$(jq -r '.omarchy.clonedFrom // empty' "$clone/manifest.json")

  if ! read -r source_dir source_manifest < <(jq -r --arg id "$source_id" '.[] | select(.id == $id) | [.sourceDir, .manifestPath] | @tsv' <<<"$catalog"); then
    notify "$(basename "$clone")" "its source plugin ${source_id:-(none)} is gone"
    continue
  fi

  for file in "$upstream"/*; do
    name=$(basename "$file")
    if [[ $name == "manifest.json" ]]; then
      current=$source_manifest
    else
      current=$source_dir/$name
    fi

    if [[ ! -f $current ]]; then
      notify "$source_id" "$name was removed upstream"
    elif ! cmp --quiet "$file" "$current"; then
      echo "To merge: git merge-file $clone/$name $file $current, then cp $current $file"
      notify "$source_id" "$name changed upstream"
    fi
  done

  # A plugin with its own folder can gain files, which the copy has never seen.
  [[ $source_manifest == "$source_dir/manifest.json" ]] || continue
  for current in "$source_dir"/*; do
    [[ -e $upstream/$(basename "$current") ]] || notify "$source_id" "$(basename "$current") was added upstream"
  done
done
