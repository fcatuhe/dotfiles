# See https://git-scm.com/docs/git-config

[user]
	name = François Catuhe
	email = francois@hey.com
	signingkey = ~/.ssh/id_ed25519.pub  # ssh-keygen reads the private key beside it, so no agent is needed
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
