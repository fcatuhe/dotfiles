ggl() {
  local branch
  branch="${1:-$(git symbolic-ref --short HEAD)}" || return
  git pull origin "$branch"
}

ggp() {
  local branch
  branch="${1:-$(git symbolic-ref --short HEAD)}" || return
  git push origin "$branch"
}

# a function cannot be declared over Omarchy's gcm alias
unalias gcm 2>/dev/null
gcm() {
  local ref
  for ref in refs/heads/main refs/heads/master refs/heads/trunk; do
    git show-ref -q --verify "$ref" && { git checkout "${ref##*/}"; return; }
  done
  echo "gcm: no main, master or trunk branch here" >&2
  return 1
}

